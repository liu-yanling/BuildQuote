# BuildQuote 配置（复制为 .env 后填写；.env 不入版本库）
# 模型 API（OpenAI 兼容协议，MVP 接 DeepSeek）
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT=60

# SQLite 数据库文件路径（轻量起步；可平滑切 PostgreSQL）
DB_PATH=./data/buildquote.db

# 落盘加密密钥（AES-256-GCM，>=32 字符，只放部署机，不进代码库）
DATA_KEY=

# 会话签名密钥（>=32 字符）
SESSION_SECRET=

LOG_LEVEL=INFO

# V4 RAG：本地开源中文 embedding（免费，默认）；也可 EMBEDDING_BACKEND=api 接 OpenAI 兼容付费接口
EMBEDDING_BACKEND=local_model
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_TIMEOUT=30

# V4 成本监控：预警阈值（黄警 ≥5%、红警 ≥10%）与科目口径文件
ALERT_YELLOW_RATIO=0.05
ALERT_RED_RATIO=0.10
COST_SUBJECTS_FILE=skills/成本科目/subjects.json

# 可选：公网访问控制（HTTP Basic 登录）。留空则不开启。
# APP_USERNAME=buildquote
# APP_PASSWORD=换成强密码
